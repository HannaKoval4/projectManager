<Window x:Class="ProjectManager.Views.EmployeeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сотрудник" Height="460" Width="720"
        MinHeight="420"
        MinWidth="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource LightGrayBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Хедер -->
        <Border Grid.Row="0"
                Background="{StaticResource DarkBlueBrush}"
                Padding="22,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Сотрудник — создание/редактирование"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Укажите ФИО и должность сотрудника."
                               Foreground="#CBD5E1"
                               FontSize="12"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="× Закрыть"
                        Style="{StaticResource HeaderCloseButton}"
                        Click="CancelButton_Click"
                        Margin="12,0,0,0"
                        VerticalAlignment="Top"/>
            </Grid>
        </Border>

        <!-- Контент -->
        <Grid Grid.Row="1" Margin="22,18,22,18">
            <Border Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="ФИО" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="NameTextBox"
                                 Margin="{StaticResource FormFieldSpacing}"/>
                        <TextBlock x:Name="NameErrorText"
                                   Visibility="Collapsed"
                                   Style="{StaticResource ErrorText}"/>

                        <TextBlock Text="Должность" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="PositionTextBox"
                                 Margin="{StaticResource FormFieldSpacing}"/>
                        <TextBlock x:Name="PositionErrorText"
                                   Visibility="Collapsed"
                                   Style="{StaticResource ErrorText}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Нижняя панель действий -->
        <Border Grid.Row="2"
                Background="{StaticResource LightGrayBrush}"
                Padding="22,0,22,22">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,6,0,0">
                <Button Content="Отмена"
                        Click="CancelButton_Click"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="140"
                        Padding="18,10"
                        Margin="0,0,12,0"/>
                <Button Content="Сохранить"
                        Click="SaveButton_Click"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="160"
                        Padding="18,10"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>






