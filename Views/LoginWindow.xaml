<Window x:Class="ProjectManager.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Менеджер проектов - Авторизация" 
        Height="640"
        Width="520"
        MinHeight="560"
        MinWidth="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource LightGrayBrush}"
        Loaded="LoginWindow_Loaded">
    <Grid>
        <Border Background="{StaticResource DarkBlueBrush}"
                Height="140"
                VerticalAlignment="Top">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="Менеджер проектов"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#E5E7EB"/>
                <TextBlock Text="Войдите в систему, чтобы работать с проектами, задачами и командой"
                           FontSize="12"
                           Foreground="#CBD5E1"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Форма авторизации -->
        <Border Style="{StaticResource CardStyle}"
                Width="420"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Вход в систему"
                           Style="{StaticResource SubHeadingText}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Введите логин и пароль, чтобы продолжить."
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,18"/>
                
                <TextBlock Text="Логин" 
                           Style="{StaticResource LabelText}"/>
                <TextBox x:Name="LoginTextBox" 
                         Margin="0,0,0,6"
                         KeyDown="Input_KeyDown"/>
                <TextBlock x:Name="LoginErrorText"
                           Visibility="Collapsed"
                           Style="{StaticResource ErrorText}"/>
                
                <TextBlock Text="Пароль" 
                           Style="{StaticResource LabelText}"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <PasswordBox x:Name="PasswordBox" 
                                 Grid.Column="0"
                                 KeyDown="Input_KeyDown"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>

                    <TextBox x:Name="PasswordTextBox"
                             Grid.Column="0"
                             Visibility="Collapsed"
                             KeyDown="Input_KeyDown"
                             TextChanged="PasswordTextBox_TextChanged"/>

                    <ToggleButton x:Name="ShowPasswordToggle"
                                  Grid.Column="1"
                                  Style="{StaticResource FieldToggleButton}"
                                  Margin="10,0,0,0"
                                  VerticalAlignment="Center"
                                  Content="Показать"
                                  Checked="ShowPasswordToggle_Checked"
                                  Unchecked="ShowPasswordToggle_Unchecked"/>
                </Grid>
                <TextBlock x:Name="PasswordErrorText"
                           Visibility="Collapsed"
                           Style="{StaticResource ErrorText}"/>

                <TextBlock x:Name="CapsLockHintText"
                           Visibility="Collapsed"
                           Foreground="{StaticResource WarningBrush}"
                           Margin="0,0,0,12"
                           Text="Caps Lock включён"/>

                <TextBlock x:Name="GeneralErrorText"
                           Visibility="Collapsed"
                           Style="{StaticResource ErrorText}"/>
                
                <Button Content="Войти" 
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Stretch"
                        Click="LoginButton_Click"
                        FontSize="16"
                        Padding="20,12"/>

                <StackPanel Margin="0,16,0,0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <TextBlock Text="Нет аккаунта? "
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="Регистрация"
                               Foreground="{StaticResource AccentBlueBrush}"
                               Cursor="Hand"
                               TextDecorations="Underline"
                               MouseLeftButtonUp="RegisterLink_MouseLeftButtonUp"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>






