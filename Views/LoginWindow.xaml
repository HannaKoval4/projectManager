<Window x:Class="ProjectManager.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Менеджер проектов — Вход"
        Height="720"
        Width="960"
        MinHeight="620"
        MinWidth="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Loaded="LoginWindow_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="LoginHeaderBrush" Color="#2C3E50"/>
        <SolidColorBrush x:Key="LoginPageBgBrush" Color="#F4F7F6"/>
        <SolidColorBrush x:Key="LoginPrimaryBrush" Color="#3498DB"/>
        <SolidColorBrush x:Key="LoginPrimaryHoverBrush" Color="#2980B9"/>
        <SolidColorBrush x:Key="LoginCardBrush" Color="#E8EBED"/>
        <SolidColorBrush x:Key="LoginCardBorderBrush" Color="#D5DCE2"/>
        <SolidColorBrush x:Key="LoginMutedBrush" Color="#7F8C8D"/>
        <SolidColorBrush x:Key="LoginLinkBrush" Color="#3498DB"/>

        <Style x:Key="LoginFieldTextBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D7E1EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="22"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource LoginPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LoginFieldPasswordBox" TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D7E1EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="22"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource LoginPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LoginCardLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
            <Setter Property="Foreground" Value="{StaticResource LoginMutedBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="LoginPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource LoginPrimaryBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="24,14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="24"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource LoginPrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginRevealToggle" TargetType="ToggleButton" BasedOn="{StaticResource FieldToggleButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource LoginMutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource LoginPageBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.3*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource LoginHeaderBrush}">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="24,0">
                <Border Width="42"
                        Height="42"
                        CornerRadius="10"
                        Background="{StaticResource LoginPrimaryBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,18"/>
                <TextBlock Text="Менеджер проектов"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>
                <TextBlock Text="Войдите в систему, чтобы работать с проектами, задачами и командой."
                           FontSize="14"
                           Foreground="#E8EEF2"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="520"
                           Opacity="0.95"
                           Margin="0,12,0,0"
                           LineHeight="22"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource LoginPageBgBrush}"/>

        <!-- Карточка поверх стыка шапки и фона -->
        <Border Grid.RowSpan="2"
                Width="440"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Margin="0,48,0,0"
                Background="{StaticResource LoginCardBrush}"
                BorderBrush="{StaticResource LoginCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Padding="36,38">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32"
                                  ShadowDepth="10"
                                  Direction="270"
                                  Opacity="0.22"
                                  Color="#1A2B3C"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Вход в систему"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextDarkBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Введите логин и пароль, чтобы продолжить."
                           Foreground="{StaticResource LoginMutedBrush}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,8,0,26"/>

                <TextBlock Text="Логин" Style="{StaticResource LoginCardLabel}"/>
                <TextBox x:Name="LoginTextBox"
                         Style="{StaticResource LoginFieldTextBox}"
                         Margin="0,0,0,4"
                         KeyDown="Input_KeyDown"/>
                <TextBlock x:Name="LoginErrorText"
                           Visibility="Collapsed"
                           Style="{StaticResource ErrorText}"/>

                <TextBlock Text="Пароль"
                           Style="{StaticResource LoginCardLabel}"
                           Margin="0,4,0,0"/>
                <Grid Margin="0,0,0,4">
                    <PasswordBox x:Name="PasswordBox"
                                 Style="{StaticResource LoginFieldPasswordBox}"
                                 KeyDown="Input_KeyDown"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>
                    <TextBox x:Name="PasswordTextBox"
                             Style="{StaticResource LoginFieldTextBox}"
                             Visibility="Collapsed"
                             Padding="14,12"
                             KeyDown="Input_KeyDown"
                             TextChanged="PasswordTextBox_TextChanged"/>
                    <ToggleButton x:Name="ShowPasswordToggle"
                                  Style="{StaticResource LoginRevealToggle}"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0"
                                  Content="Показать"
                                  Visibility="Collapsed"
                                  Checked="ShowPasswordToggle_Checked"
                                  Unchecked="ShowPasswordToggle_Unchecked"/>
                </Grid>
                <TextBlock x:Name="PasswordErrorText"
                           Visibility="Collapsed"
                           Style="{StaticResource ErrorText}"/>

                <TextBlock x:Name="CapsLockHintText"
                           Visibility="Collapsed"
                           Foreground="{StaticResource WarningBrush}"
                           Margin="0,0,0,8"
                           Text="Caps Lock включён"/>

                <TextBlock x:Name="GeneralErrorText"
                           Visibility="Collapsed"
                           Style="{StaticResource ErrorText}"/>

                <Grid Margin="0,6,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="RememberMeCheckBox"
                              Grid.Column="0"
                              VerticalAlignment="Center"
                              Content="Запомнить меня"
                              Foreground="{StaticResource LoginMutedBrush}"
                              FontSize="13"
                              Cursor="Hand"/>
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Text="Забыли пароль?"
                               Foreground="{StaticResource LoginLinkBrush}"
                               FontSize="13"
                               Cursor="Hand"
                               MouseLeftButtonUp="ForgotPassword_MouseLeftButtonUp"/>
                </Grid>

                <Button Content="Войти"
                        Style="{StaticResource LoginPrimaryButton}"
                        HorizontalAlignment="Stretch"
                        Click="LoginButton_Click"/>

                <StackPanel HorizontalAlignment="Center"
                            Margin="0,22,0,0">
                    <TextBlock Text="Нет аккаунта?"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource LoginMutedBrush}"
                               FontSize="13"
                               Margin="0,0,0,10"/>
                    <Button Content="Регистрация"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Stretch"
                            FontSize="15"
                            Padding="20,12"
                            Click="RegisterButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
