<UserControl x:Class="ProjectManager.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="{StaticResource LightGrayBrush}">
    <Grid Margin="24,20,24,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Проекты"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextDarkBrush}"/>
                    <TextBlock Text="Общий вид приложения с перечнем проектов."
                               FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <Button Content="Добавить"
                            Style="{StaticResource ToolbarPrimaryButton}"
                            Command="{Binding AddProjectCommand}"/>
                    <Button Content="Изменить"
                            Style="{StaticResource ToolbarOutlineButton}"
                            Command="{Binding EditProjectCommand}"/>
                    <Button Content="Завершить"
                            Style="{StaticResource ToolbarOutlineButton}"
                            Margin="0"
                            Command="{Binding CompleteProjectCommand}"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Projects}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="300"
                                    MinHeight="188"
                                    MouseLeftButtonDown="ProjectCard_MouseLeftButtonDown"
                                    Cursor="Hand"
                                    Margin="0,0,16,16"
                                    Background="White"
                                    BorderBrush="#E8ECEF"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="20,18">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.08"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="{Binding Name}"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextDarkBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Description}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               MaxHeight="44"
                                               Margin="0,0,0,12"/>

                                    <ProgressBar Grid.Row="2"
                                                 Value="{Binding CompletionPercentage, Mode=OneWay}"
                                                 Maximum="100"
                                                 Height="6"
                                                 Margin="0,0,0,12"/>

                                    <Grid Grid.Row="3" Margin="0,0,0,10">
                                        <TextBlock HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextMutedBrush}">
                                            <Run Text="Активных задач: "/>
                                            <Run Text="{Binding ActiveTasksCount, Mode=OneWay}"
                                                 Foreground="{StaticResource AccentBlueBrush}"
                                                 FontWeight="SemiBold"/>
                                        </TextBlock>
                                        <TextBlock HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextDarkBrush}"
                                                   Text="{Binding CompletionPercentage, Mode=OneWay, StringFormat={}{0:0}%}"/>
                                    </Grid>

                                    <StackPanel Grid.Row="4" Orientation="Horizontal">
                                        <TextBlock Text="Срок проекта: "
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Deadline, StringFormat='{}{0:dd.MM.yyyy}', TargetNullValue=—}"
                                                   Foreground="{Binding Deadline, Converter={StaticResource DeadlineToForegroundBrushConverter}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border Grid.Column="1"
                Background="{StaticResource PanelGrayBrush}"
                CornerRadius="16"
                Padding="18,18">
            <Grid>
                <TextBlock Text="Выберите проект в списке слева"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="12,0"
                           Visibility="{Binding SelectedProject, Converter={StaticResource ObjectNotNullToVisibilityConverter}, ConverterParameter=invert}"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SelectedProject, Converter={StaticResource ObjectNotNullToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Выбран проект"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <Grid Margin="0,6,0,16">
                            <TextBlock Text="{Binding SelectedProject.Name}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextDarkBrush}"
                                       TextWrapping="Wrap"
                                       Padding="0,0,52,0"/>
                            <Ellipse Width="40"
                                     Height="40"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF9A6B" Offset="0"/>
                                        <GradientStop Color="#FFB89A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>

                        <Border Background="White"
                                CornerRadius="14"
                                Padding="14,14"
                                Margin="0,0,0,12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Кратко"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextDarkBrush}"
                                           Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Width="28" Height="28" CornerRadius="8" Background="#E3F2FD" Margin="0,0,8,0"/>
                                    <Border Width="28" Height="28" CornerRadius="8" Background="#FFF3E0" Margin="0,0,8,0"/>
                                    <Border Width="28" Height="28" CornerRadius="8" Background="#E8F5E9"/>
                                </StackPanel>
                                <Border Background="#E8F5E9"
                                        CornerRadius="20"
                                        Padding="12,6"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="В работе"
                                               FontSize="11"
                                               Foreground="#2E7D32"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Background="White"
                                CornerRadius="14"
                                Padding="14,14"
                                Margin="0,0,0,12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Описание"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextDarkBrush}"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding SelectedProject.Description}"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           MaxHeight="120"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White"
                                CornerRadius="14"
                                Padding="14,14"
                                Margin="0,0,0,16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Прогресс"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextDarkBrush}"
                                           Margin="0,0,0,10"/>
                                <ProgressBar Height="8"
                                             Maximum="100"
                                             Value="{Binding SelectedProject.CompletionPercentage, Mode=OneWay}"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Редактировать"
                                    Style="{StaticResource ToolbarOutlineButton}"
                                    Margin="0,0,10,0"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding EditProjectCommand}"/>
                            <Button Content="Удалить"
                                    Style="{StaticResource ToolbarOutlineButton}"
                                    Margin="0"
                                    IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
