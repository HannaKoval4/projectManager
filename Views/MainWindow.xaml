<Window x:Class="ProjectManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:ProjectManager.Converters"
        mc:Ignorable="d"
        Title="Менеджер проектов"
        Height="820"
        Width="1480"
        MinHeight="640"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource LightGrayBrush}">
    <Window.Resources>
        <conv:StringEqualsConverter x:Key="StringEqualsConverter"/>
        <Style x:Key="SidebarSearchBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#ECF0F1"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Background" Value="#34495E"/>
            <Setter Property="BorderBrush" Value="#4A6278"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="268"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая колонка: навигация -->
        <Border Grid.Column="0"
                Background="{StaticResource DarkBlueBrush}"
                Padding="14,20,14,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="4,0,4,8">
                    <TextBlock Text="Менеджер проектов"
                               Foreground="White"
                               FontSize="17"
                               FontWeight="SemiBold"
                               FontFamily="{StaticResource MainFont}"
                               Margin="0,0,0,14"/>
                    <TextBox Style="{StaticResource SidebarSearchBox}"
                             Text="Навигация"
                             Padding="14,10"
                             Margin="0,0,0,4"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <RadioButton Content="Проекты"
                                 Style="{StaticResource NavPill}"
                                 GroupName="Nav"
                                 Tag="{Binding ProjectsCount}"
                                 IsChecked="{Binding CurrentView, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Projects}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Projects"/>
                    <RadioButton Content="Задачи"
                                 Style="{StaticResource NavPill}"
                                 GroupName="Nav"
                                 Tag="{Binding TasksCount}"
                                 IsChecked="{Binding CurrentView, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Tasks}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Tasks"/>
                    <RadioButton Content="Команда"
                                 Style="{StaticResource NavPill}"
                                 GroupName="Nav"
                                 Tag="{Binding EmployeesCount}"
                                 IsChecked="{Binding CurrentView, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Team}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Team"/>
                    <RadioButton Content="Статистика"
                                 Style="{StaticResource NavPill}"
                                 GroupName="Nav"
                                 Tag="{Binding StatisticsBadge}"
                                 IsChecked="{Binding CurrentView, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Statistics}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Statistics"/>
                    <RadioButton Content="Справка"
                                 Style="{StaticResource NavPill}"
                                 GroupName="Nav"
                                 Tag="{Binding HelpBadge}"
                                 IsChecked="{Binding CurrentView, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Help}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Help"/>
                </StackPanel>

                <Border Grid.Row="2"
                        Background="#34495E"
                        CornerRadius="14"
                        Padding="14,12"
                        Margin="4,16,4,0">
                    <StackPanel>
                        <TextBlock Text="Пользователь"
                                   Foreground="#BDC3C7"
                                   FontSize="11"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding CurrentUser}"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Content="Выйти"
                                Style="{StaticResource NavButton}"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding LogoutCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ContentControl Grid.Column="1"
                        Margin="0"
                        Content="{Binding CurrentViewContent}"/>
    </Grid>
</Window>
