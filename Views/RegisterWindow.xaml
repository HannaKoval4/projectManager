<Window x:Class="ProjectManager.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Менеджер проектов - Регистрация"
        Height="820"
        Width="640"
        MinHeight="760"
        MinWidth="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource LightGrayBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource DarkBlueBrush}"
                Padding="20">
            <TextBlock Text="Регистрация"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       FontFamily="{StaticResource MainFont}"/>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Margin="40"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch">
            <StackPanel>
                <TextBlock Text="Создайте аккаунт"
                           Style="{StaticResource HeadingText}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,18"/>

                <TextBlock Text="Логин"
                           Style="{StaticResource LabelText}"/>
                <TextBox x:Name="UsernameTextBox"
                         Margin="0,0,0,6"/>
                <TextBlock x:Name="UsernameErrorText"
                           Visibility="Collapsed"
                           Style="{StaticResource ErrorText}"/>

                <TextBlock Text="Пароль"
                           Style="{StaticResource LabelText}"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <PasswordBox x:Name="PasswordBox"
                                 Grid.Column="0"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>
                    <TextBox x:Name="PasswordTextBox"
                             Grid.Column="0"
                             Visibility="Collapsed"
                             TextChanged="PasswordTextBox_TextChanged"/>
                    <ToggleButton x:Name="ShowPasswordToggle"
                                  Grid.Column="1"
                                  Style="{StaticResource FieldToggleButton}"
                                  Margin="10,0,0,0"
                                  VerticalAlignment="Center"
                                  Content="Показать"
                                  Checked="ShowPasswordToggle_Checked"
                                  Unchecked="ShowPasswordToggle_Unchecked"/>
                </Grid>
                <TextBlock x:Name="PasswordErrorText"
                           Visibility="Collapsed"
                           Style="{StaticResource ErrorText}"/>

                <TextBlock Text="Повторите пароль"
                           Style="{StaticResource LabelText}"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <PasswordBox x:Name="ConfirmPasswordBox"
                                 Grid.Column="0"
                                 PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>
                    <TextBox x:Name="ConfirmPasswordTextBox"
                             Grid.Column="0"
                             Visibility="Collapsed"
                             TextChanged="ConfirmPasswordTextBox_TextChanged"/>
                    <ToggleButton x:Name="ShowConfirmPasswordToggle"
                                  Grid.Column="1"
                                  Style="{StaticResource FieldToggleButton}"
                                  Margin="10,0,0,0"
                                  VerticalAlignment="Center"
                                  Content="Показать"
                                  Checked="ShowConfirmPasswordToggle_Checked"
                                  Unchecked="ShowConfirmPasswordToggle_Unchecked"/>
                </Grid>
                <TextBlock x:Name="ConfirmPasswordErrorText"
                           Visibility="Collapsed"
                           Style="{StaticResource ErrorText}"
                           Margin="0,2,0,16"/>

                <TextBlock Text="ФИО (опционально)"
                           Style="{StaticResource LabelText}"/>
                <TextBox x:Name="FullNameTextBox"
                         Margin="0,0,0,12"/>

                <TextBlock Text="Должность (опционально)"
                           Style="{StaticResource LabelText}"/>
                <TextBox x:Name="PositionTextBox"
                         Margin="0,0,0,18"/>

                <TextBlock x:Name="GeneralErrorText"
                           Visibility="Collapsed"
                           Style="{StaticResource ErrorText}"/>

                <Border x:Name="ToastBorder"
                        Visibility="Collapsed"
                        CornerRadius="6"
                        Padding="12"
                        Margin="0,0,0,12">
                    <TextBlock x:Name="ToastText"
                               Foreground="White"
                               TextWrapping="Wrap"/>
                </Border>

                <StackPanel x:Name="ProgressPanel"
                            Visibility="Collapsed"
                            Orientation="Horizontal"
                            Margin="0,0,0,12"
                            VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True"
                                 Width="120"
                                 Height="8"
                                 Margin="0,0,10,0"/>
                    <TextBlock x:Name="ProgressText"
                               VerticalAlignment="Center"
                               Text="Создаём аккаунт..."/>
                </StackPanel>

                <Button x:Name="CreateAccountButton"
                        Content="Создать аккаунт"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Stretch"
                        Click="CreateAccountButton_Click"
                        FontSize="16"
                        Padding="20,12"/>

                <Button x:Name="BackButton"
                        Content="Назад"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Stretch"
                        Click="BackButton_Click"
                        FontSize="14"
                        Padding="20,10"
                        Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

