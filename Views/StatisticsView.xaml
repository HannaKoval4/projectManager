<UserControl x:Class="ProjectManager.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1100"
             Background="{StaticResource LightGrayBrush}">
    <Grid Margin="24,20,24,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Статистика"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextDarkBrush}"/>
                    <TextBlock Text="Динамика прогресса, распределение задач и нагрузка команды"
                               FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Период: 01.04–30.06"
                            Style="{StaticResource ToolbarOutlineButton}"
                            Margin="0,0,8,0"
                            IsEnabled="False"/>
                    <Button Content="Экспорт"
                            Style="{StaticResource ToolbarOutlineButton}"
                            Margin="0"/>
                </StackPanel>
            </Grid>

            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
                <Border Background="#ECEFF1" CornerRadius="14" Padding="16,12" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Проектов активных" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ActiveProjectsCount}" FontSize="24" FontWeight="Bold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#ECEFF1" CornerRadius="14" Padding="16,12" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="Задач просрочено" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding OverdueTasksStat}" FontSize="24" FontWeight="Bold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#ECEFF1" CornerRadius="14" Padding="16,12" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="Средний прогресс" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock FontSize="24" FontWeight="Bold" Margin="0,6,0,0">
                            <Run Text="{Binding AverageProgressRounded, Mode=OneWay}"/><Run Text="%"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Background="#ECEFF1" CornerRadius="14" Padding="16,12" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Загрузка команды" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                        <TextBlock FontSize="24" FontWeight="Bold" Margin="0,6,0,0">
                            <Run Text="{Binding TeamWorkloadRounded, Mode=OneWay}"/><Run Text="%"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="16"
                        Padding="18"
                        Margin="0,0,8,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.06"/>
                    </Border.Effect>
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Прогресс проектов по неделям" FontWeight="Bold" FontSize="15"/>
                            <Border HorizontalAlignment="Right" Background="#E8F5E9" CornerRadius="12" Padding="10,4">
                                <TextBlock Text="+8% за 4 недели" FontSize="11" Foreground="#2E7D32"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="Суммарная динамика по выбранному периоду"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,16"/>
                        <Border Height="160" Background="#F4F7F6" CornerRadius="12">
                            <Canvas>
                                <Path Stroke="#7FB3E8" StrokeThickness="2" Fill="#337FB3E8"
                                      Data="M 10,120 Q 60,100 120,80 T 240,40 L 240,140 L 10,140 Z"/>
                                <Polyline Points="10,120 60,100 120,80 180,55 240,40"
                                          Stroke="#3498DB"
                                          StrokeThickness="2"/>
                            </Canvas>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="16"
                        Padding="18"
                        Margin="8,0,0,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.06"/>
                    </Border.Effect>
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Задачи по статусам" FontWeight="Bold" FontSize="15"/>
                            <TextBlock Text="{Binding TasksTotalStat, Mode=OneWay}"
                                       HorizontalAlignment="Right"
                                       FontWeight="Bold"
                                       FontSize="16"/>
                        </Grid>
                        <TextBlock Text="Распределение на текущую дату"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,16"/>
                        <Border Height="160" Background="#F4F7F6" CornerRadius="12" Padding="12,0">
                            <UniformGrid Columns="5" VerticalAlignment="Bottom" Height="120">
                                <Border Background="#7FB3E8" CornerRadius="8,8,0,0" Margin="4,0" VerticalAlignment="Bottom" Height="90"/>
                                <Border Background="#9B7FD9" CornerRadius="8,8,0,0" Margin="4,0" VerticalAlignment="Bottom" Height="70"/>
                                <Border Background="#F2C94C" CornerRadius="8,8,0,0" Margin="4,0" VerticalAlignment="Bottom" Height="55"/>
                                <Border Background="#7DCEA0" CornerRadius="8,8,0,0" Margin="4,0" VerticalAlignment="Bottom" Height="100"/>
                                <Border Background="#F1948A" CornerRadius="8,8,0,0" Margin="4,0" VerticalAlignment="Bottom" Height="65"/>
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Column="1"
                Background="{StaticResource PanelGrayBrush}"
                CornerRadius="16"
                Padding="16">
            <StackPanel>
                <TextBlock Text="Сводка по проектам" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Text="Прогресс" FontSize="18" FontWeight="Bold" Margin="0,4,0,14"/>
                <Border Background="White" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <ProgressBar Margin="0,6" Height="8" Value="72" Maximum="100"/>
                        <ProgressBar Margin="0,6" Height="8" Value="45" Maximum="100"/>
                        <ProgressBar Margin="0,6" Height="8" Value="88" Maximum="100"/>
                        <ProgressBar Margin="0,6" Height="8" Value="33" Maximum="100"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="Легенда" FontWeight="Bold" FontSize="15" Margin="0,8,0,8"/>
                <Border Background="White" CornerRadius="14" Padding="12">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#E8F5E9" CornerRadius="10" Width="48" Height="22" Margin="0,0,8,0"/>
                        <Border Background="#FFF9C4" CornerRadius="10" Width="48" Height="22" Margin="0,0,8,0"/>
                        <Border Background="#FFEBEE" CornerRadius="10" Width="48" Height="22"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="Скриншот этого экрана хорошо показывает прогресс-бары"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,14,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
