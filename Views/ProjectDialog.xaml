<Window x:Class="ProjectManager.Views.ProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Проект"
        Height="640"
        Width="1040"
        MinHeight="560"
        MinWidth="920"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#8C8C8C">
    <Border CornerRadius="20" Margin="16" Background="#8C8C8C">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="22,18,22,12">
                <TextBlock Text="Проект — создание/редактирование"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#2C3E50"/>
                <Button Content="✕  Закрыть"
                        HorizontalAlignment="Right"
                        Style="{StaticResource HeaderCloseButton}"
                        Click="CancelButton_Click"
                        Background="#B0B0B0"
                        Foreground="#333333"/>
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="18,0,18,0" VerticalScrollBarVisibility="Auto">
                <Grid Margin="4,0,4,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левая колонка -->
                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                        <TextBlock Text="Название проекта" Style="{StaticResource LabelText}"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="{StaticResource FormFieldSpacing}"/>
                        <TextBlock Text="Название обязательно"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontSize="12"
                                   Margin="0,0,0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NameInvalid}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Клиент" Style="{StaticResource LabelText}"/>
                                <TextBox Text="{Binding Client, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Ответственный" Style="{StaticResource LabelText}"/>
                                <ComboBox ItemsSource="{Binding Employees}"
                                          SelectedItem="{Binding Responsible}"
                                          DisplayMemberPath="FullName"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Описание" Style="{StaticResource LabelText}"/>
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="120"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="{StaticResource FormFieldSpacing}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Дата начала" Style="{StaticResource LabelText}"/>
                                <DatePicker SelectedDate="{Binding StartDate}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Дедлайн" Style="{StaticResource LabelText}"/>
                                <DatePicker SelectedDate="{Binding Deadline}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Правая колонка -->
                    <StackPanel Grid.Column="1">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Статус" Style="{StaticResource LabelText}"/>
                                <ComboBox ItemsSource="{Binding StatusOptions}"
                                          SelectedItem="{Binding ProjectStatus}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Приоритет" Style="{StaticResource LabelText}"/>
                                <ComboBox ItemsSource="{Binding PriorityOptions}"
                                          SelectedItem="{Binding ProjectPriority}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Бюджет" Style="{StaticResource LabelText}"/>
                                <TextBox Text="{Binding Budget, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Теги" Style="{StaticResource LabelText}"/>
                                <TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Через запятую, например: web, auth, docs"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Прогресс" Style="{StaticResource LabelText}"/>
                        <Border Background="White" CornerRadius="14" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Border HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="#E8F5E9"
                                        CornerRadius="12"
                                        Padding="10,4">
                                    <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0:0}%}"
                                               FontWeight="SemiBold"
                                               Foreground="#2E7D32"/>
                                </Border>
                                <ProgressBar Margin="0,28,0,0"
                                             Height="10"
                                             Maximum="100"
                                             Value="{Binding ProgressPercent}"/>
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                            <Button Content="Сохранить"
                                    Padding="16,8"
                                    Margin="0,0,8,0"
                                    Background="#A5D6A7"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Click="SaveButton_Click"/>
                            <Button Content="Черновик"
                                    Padding="16,8"
                                    Margin="0,0,8,0"
                                    Background="#D7CCC8"
                                    Foreground="White"
                                    BorderThickness="0"
                                    IsEnabled="False"/>
                            <Button Content="Удалить"
                                    Padding="16,8"
                                    Background="#EF9A9A"
                                    Foreground="White"
                                    BorderThickness="0"
                                    IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="22,12,22,18">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена"
                            Click="CancelButton_Click"
                            Style="{StaticResource SecondaryButton}"
                            MinWidth="120"
                            Margin="0,0,12,0"/>
                    <Button Content="Сохранить"
                            Click="SaveButton_Click"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="140"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
