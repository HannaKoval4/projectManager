<Window x:Class="ProjectManager.Views.ProjectDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ProjectManager.Converters"
        Title="Проект"
        Height="780"
        MinHeight="600"
        Width="1080"
        MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource LightGrayBrush}">
    <Window.Resources>
        <conv:PriorityToColorConverter x:Key="PriorityToColor"/>
        <conv:StatusToColorConverter x:Key="StatusToColor"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource DarkBlueBrush}" Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="Просмотр, заметки и задачи" Foreground="#CBD5E1" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Обновить" Style="{StaticResource SecondaryButton}" Padding="16,8"
                            Command="{Binding ReloadCommand}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                    <Button Content="Закрыть" Style="{StaticResource HeaderCloseButton}"
                            Click="CloseButton_Click" VerticalAlignment="Top"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" MinWidth="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Сводка" Style="{StaticResource SubHeadingText}" Margin="0,0,0,12"/>
                            <TextBlock Text="Описание" Style="{StaticResource LabelText}"/>
                            <TextBlock Text="{Binding Description}" Style="{StaticResource HelperText}" Margin="0,0,0,14" MinHeight="32"/>
                            <TextBlock Text="Дедлайн" Style="{StaticResource LabelText}"/>
                            <TextBlock FontSize="14" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,14"
                                       Text="{Binding Deadline, StringFormat='{}{0:dd MMMM yyyy}', TargetNullValue=—}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Прогресс" Style="{StaticResource SubHeadingText}" Margin="0,0,0,8"/>
                            <ProgressBar Value="{Binding CompletionPercent, Mode=OneWay}" Height="10" Maximum="100" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding ProgressSummary}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,6"/>
                            <Border CornerRadius="8" Background="#ECFDF5" Padding="10,6" Margin="0,6,0,0" HorizontalAlignment="Left">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="Проект завершён" Foreground="#166534" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Ваши заметки" Style="{StaticResource SubHeadingText}" Margin="0,0,0,8"/>
                            <TextBlock Text="Собственная информация, ссылки, напоминания — хранятся в базе."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="120" MaxHeight="220"
                                     FontSize="13" Padding="10"/>
                            <Button Content="Сохранить заметки" Style="{StaticResource SuccessButton}" HorizontalAlignment="Left"
                                    Margin="0,12,0,0" Padding="18,10" Command="{Binding SaveNotesCommand}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" MinWidth="0">
                    <TextBlock Text="Задачи проекта" Style="{StaticResource SubHeadingText}" Margin="0,0,0,12"/>
                    <TextBlock Text="Пока нет задач — создайте их на вкладке «Задачи»."
                               Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNoTasks}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding TaskRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14" Padding="0">
                                    <StackPanel>
                                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextDarkBrush}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding EmployeeName}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                                    <Border CornerRadius="8" Padding="8,3" Margin="0,0,6,0" MinWidth="72" HorizontalAlignment="Right"
                                                            Background="{Binding Priority, Converter={StaticResource PriorityToColor}}">
                                                        <TextBlock Text="{Binding Priority}" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <Border CornerRadius="8" Padding="8,3" MinWidth="88" HorizontalAlignment="Right"
                                                            Background="{Binding Status, Converter={StaticResource StatusToColor}}">
                                                        <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <StackPanel Margin="16,0,16,12">
                                            <TextBlock Text="Комментарии" Style="{StaticResource LabelText}" FontSize="11" Margin="0,10,0,6"/>
                                            <ItemsControl ItemsSource="{Binding Comments}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#F8FAFC" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                    <TextBlock Text="{Binding Author, TargetNullValue=—}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                                                    <TextBlock Text="  •  " Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                                                    <TextBlock Text="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH\\:mm}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource TextDarkBrush}" FontSize="13"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBox Text="{Binding NewCommentText, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,6"
                                                     MinHeight="40" TextWrapping="Wrap" AcceptsReturn="True" FontSize="13" Padding="8" VerticalContentAlignment="Top"
                                                     ToolTip="Комментарий к задаче"/>
                                            <Button Content="Добавить комментарий" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="14,8"
                                                    Command="{Binding AddCommentCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
