<UserControl x:Class="ProjectManager.Views.TeamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="{StaticResource LightGrayBrush}">
    <Grid Margin="24,20,24,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Команда" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}"/>
                    <TextBlock Text="Сотрудники, роли, контакты и назначение на проекты."
                               FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox Width="140" Margin="0,0,8,0" SelectedIndex="0">
                            <ComboBoxItem Content="Роль: Все"/>
                        </ComboBox>
                        <ComboBox Width="160" SelectedIndex="0">
                            <ComboBoxItem Content="Статус: Активен"/>
                        </ComboBox>
                    </StackPanel>
                    <Button Content="+ Добавить сотрудника"
                            Style="{StaticResource ToolbarPrimaryButton}"
                            HorizontalAlignment="Right"
                            Command="{Binding AddEmployeeCommand}"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="12" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#C8E6C9" CornerRadius="12" Padding="14,8" Margin="0,0,8,0">
                        <TextBlock Text="Карточки" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#EDF1F4" CornerRadius="12" Padding="14,8">
                        <TextBlock Text="Таблица" Foreground="{StaticResource TextMutedBrush}"/>
                    </Border>
                    <TextBox Width="320"
                             Margin="24,0,0,0"
                             VerticalContentAlignment="Center"
                             Padding="12,8"
                             Text="Поиск сотрудников..."
                             Foreground="{StaticResource TextMutedBrush}"
                             IsReadOnly="True"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Employees}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="260"
                                    Margin="0,0,14,14"
                                    Background="#ECEFF1"
                                    CornerRadius="14"
                                    Padding="16,14"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="EmployeeCard_MouseLeftButtonDown">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="48" Height="48" Margin="0,0,12,0">
                                        <Ellipse.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#667EEA" Offset="0"/>
                                                <GradientStop Color="#764BA2" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding FullName}" FontWeight="Bold" TextWrapping="Wrap"/>
                                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,8">
                                            <Run Text="{Binding Position, Mode=OneWay}"/><Run Text=" · "/><Run Text="email@company.ru" Foreground="#95A5A6"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Skills}"
                                                   FontSize="11"
                                                   Foreground="#7F8C8D"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border Grid.Column="1"
                Background="{StaticResource PanelGrayBrush}"
                CornerRadius="16"
                Padding="16">
            <StackPanel>
                <TextBlock Text="Карточка сотрудника" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Text="{Binding SelectedEmployee.FullName, TargetNullValue=—}"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,4,0,16"
                           TextWrapping="Wrap"/>

                <Border Background="White" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Детали" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="22" Height="22" Background="#E3F2FD" CornerRadius="6" Margin="0,0,8,0"/>
                            <Border Width="22" Height="22" Background="#E3F2FD" CornerRadius="6" Margin="0,0,8,0"/>
                            <Border Width="22" Height="22" Background="#E3F2FD" CornerRadius="6" Margin="0,0,8,0"/>
                            <Border Width="22" Height="22" Background="#E3F2FD" CornerRadius="6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="14" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Загрузка" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <ProgressBar Height="8" Value="70" Maximum="100"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Редактировать"
                            Style="{StaticResource ToolbarOutlineButton}"
                            Margin="0,0,8,0"
                            Command="{Binding EditEmployeeCommand}"/>
                    <Button Content="Назначить на проект"
                            Style="{StaticResource ToolbarPrimaryButton}"
                            Margin="0"
                            Command="{Binding EditEmployeeCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
