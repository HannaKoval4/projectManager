<UserControl x:Class="ProjectManager.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="{StaticResource LightGrayBrush}">
    <UserControl.Resources>
        <Style x:Key="StatusChipListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem" x:Key="ChipListBoxItem">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ChipBd"
                                Background="#EDF1F4"
                                CornerRadius="16"
                                Padding="14,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ChipBd" Property="Background" Value="{StaticResource MintChipBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="24,20,24,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Задачи"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextDarkBrush}"/>
                    <TextBlock Text="Список задач по проектам, статусам и исполнителям."
                               FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,6,0,0"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="+ Добавить задачу"
                        Style="{StaticResource ToolbarPrimaryButton}"
                        VerticalAlignment="Top"
                        Command="{Binding AddTaskCommand}"/>
            </Grid>

            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="14"
                    Padding="16,14"
                    Margin="0,0,0,14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.06"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Проект:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextMutedBrush}"/>
                        <ComboBox Width="200"
                                  ItemsSource="{Binding Projects}"
                                  SelectedItem="{Binding SelectedProjectFilter}"
                                  DisplayMemberPath="Name"/>
                        <ListBox Style="{StaticResource StatusChipListBox}"
                                 ItemContainerStyle="{StaticResource ChipListBoxItem}"
                                 ItemsSource="{Binding StatusChipOptions}"
                                 SelectedItem="{Binding StatusChip}"
                                 Margin="16,0,0,0"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Приоритет:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextMutedBrush}"/>
                        <ComboBox Width="180"
                                  Margin="0,0,16,0"
                                  ItemsSource="{Binding PriorityFilterOptions}"
                                  SelectedItem="{Binding SelectedPriorityFilter}"/>
                        <TextBlock Text="Исполнитель:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextMutedBrush}"/>
                        <ComboBox Width="200"
                                  ItemsSource="{Binding Employees}"
                                  SelectedItem="{Binding SelectedEmployeeFilter}"
                                  DisplayMemberPath="FullName"
                                  Margin="0,0,16,0"/>
                        <TextBox Width="220"
                                 VerticalContentAlignment="Center"
                                 Padding="12,8"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Поиск задач"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,16">
                <Border Background="#ECEFF1" CornerRadius="14" Padding="18,14" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Всего задач" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding TotalTasksCount}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#ECEFF1" CornerRadius="14" Padding="18,14" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Просрочено" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding OverdueTasksCount}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#ECEFF1" CornerRadius="14" Padding="18,14" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="В работе" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding InProgressTasksCount}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="3"
                    Background="White"
                    CornerRadius="14"
                    BorderBrush="#E8ECEF"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.07"/>
                </Border.Effect>
                <DataGrid ItemsSource="{Binding FilteredTasks}"
                          SelectedItem="{Binding SelectedTask}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          RowHeight="40"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Задача" Binding="{Binding Title}" Width="2*" MinWidth="160"/>
                        <DataGridTextColumn Header="Проект" Binding="{Binding Project.UiShortName}" Width="*" MinWidth="80"/>
                        <DataGridTextColumn Header="Исполнитель" Binding="{Binding Employee.ShortFirstName, TargetNullValue=—}" Width="*" MinWidth="80"/>
                        <DataGridTemplateColumn Header="Статус" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusDisplay}" FontSize="12" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#7F8C8D"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusDisplay}" Value="Просрочено">
                                                        <Setter Property="Foreground" Value="#C62828"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority}" Width="100"/>
                        <DataGridTextColumn Header="Срок" Binding="{Binding DueDate, StringFormat='{}{0:dd.MM}'}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <Border Grid.Column="1"
                Background="{StaticResource PanelGrayBrush}"
                CornerRadius="16"
                Padding="16,16">
            <StackPanel>
                <TextBlock Text="Быстрые действия"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextDarkBrush}"/>
                <TextBlock Text="Фильтры и статусы задач"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,4,0,16"/>

                <Border Background="White" CornerRadius="14" Padding="14,12" Margin="0,0,0,12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.05"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#E8F5E9" CornerRadius="12" Width="40" Height="22" Margin="0,0,8,0"/>
                        <Border Background="#FFEBEE" CornerRadius="12" Padding="10,4">
                            <TextBlock Text="Просрочено" FontSize="11" Foreground="#C62828"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="14" Padding="14,12" Margin="0,0,0,12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.05"/>
                    </Border.Effect>
                    <StackPanel>
                        <Button Content="Редактировать"
                                Style="{StaticResource ToolbarOutlineButton}"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Stretch"
                                Command="{Binding EditTaskCommand}"/>
                        <Button Content="Удалить"
                                Style="{StaticResource ToolbarOutlineButton}"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Stretch"
                                Command="{Binding CompleteTaskCommand}"/>
                        <Button Content="Назначить"
                                Style="{StaticResource ToolbarPrimaryButton}"
                                Margin="0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding EditTaskCommand}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Подсказка: здесь удобно показать фильтры/кнопки статусов на скриншоте."
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
